      <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
      <column caption='BalanceStatus (copy)' datatype='string' name='[BalanceStatus (copy)_2611392068497408]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4196612752306176] &lt; 10&#13;&#10; THEN NULL&#13;&#10;ELSE &quot;X&quot;&#13;&#10;END' />
      </column>
      <column caption='Spare' datatype='integer' name='[Calculation_1782360035901440]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF NOT ISNULL([C###]) AND  (ISNULL([Allocation]) OR [Allocation] &lt;0.4)&#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Worker' datatype='string' name='[Calculation_1782360046370818]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='[Facility]+[Role]+STR([Resource])' />
      </column>
      <column caption='AllocationCount' datatype='integer' name='[Calculation_1782360048431107]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Allocation] &gt;.1 THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='OtherAvailableShifts' datatype='real' name='[Calculation_1782360069238788]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  NOT ISNULL([Calculation_1782360035901440]) OR  NOT ISNULL([Allocation])&#13;&#10;THEN NULL &#13;&#10;ELSE [OriginalAvailability]&#13;&#10;END' />
      </column>
      <column caption='BalanceWeeks' datatype='real' name='[Calculation_4196612752306176]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[Value] / 38' />
      </column>
      <column caption='BalanceStatus' datatype='string' name='[Calculation_4196612752678913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4196612752306176]  &lt; 2 THEN NULL&#13;&#10;ELSEIF [Calculation_4196612752306176] &lt; 5 THEN &quot;L&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176] &lt; 8 THEN &quot;M&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176]&lt; 13 THEN &quot;H&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176] &gt; 20 THEN  &quot;X&quot;&#13;&#10;END' />
      </column>
      <column caption='LB Status-modified' datatype='string' name='[Calculation_4824434444849152]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  ISNULL([LBStatus]) THEN &quot;Not listed in leave data&quot;&#13;&#10;ELSE [LBStatus]&#13;&#10;END' />
        <aliases>
          <alias key='&quot;Not listed in leave data&quot;' value='Not in Leave Balance Data' />
        </aliases>
      </column>
      <column caption='ResShiftUse' datatype='string' name='[Calculation_5865947677237250]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF NOT ISNULL([Allocation]) THEN &quot;Allocation&quot;&#13;&#10;ELSEIF NOT ISNULL([C###]) THEN &quot;Spare&quot;&#13;&#10;ELSEIF NOT ISNULL([OriginalAvailability]) THEN &quot;Other availability&quot;&#13;&#10;END' />
      </column>
      <column caption='ResShiftValue' datatype='real' name='[Calculation_5865947679870979]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Calculation_5865947677237250] = &quot;Spare&quot; THEN [C###]&#13;&#10;ELSEIF [Calculation_5865947677237250] = &quot;Allocation&quot; THEN [Allocation]&#13;&#10;ELSEIF  [Calculation_5865947677237250] = &quot;Other availability&quot; THEN [OriginalAvailability]&#13;&#10;END' />
      </column>
