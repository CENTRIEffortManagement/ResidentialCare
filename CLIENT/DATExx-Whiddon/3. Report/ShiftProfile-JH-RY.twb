      <column caption='MatchingRolesAllocation' datatype='real' name='[Calculation_2125417558289084416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Role1] = [Role (EffortAllMatrixAG1-1D)] then [Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
