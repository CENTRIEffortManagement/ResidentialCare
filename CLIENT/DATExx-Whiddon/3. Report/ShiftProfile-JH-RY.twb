    <action caption='Highlight Staft All Shifts' name='[Action3_61AA1ACFD1C047F4A542B78D2866723D]'>
      <activation auto-clear='true' type='on-select' />
      <source dashboard='SHIFTPROFILE-B' type='sheet'>
