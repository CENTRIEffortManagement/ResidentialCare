  <worksheets>
    <worksheet name='ALLRole'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='22'>STAFF ALLOCATIONS by EFFECTIVE EFFORT</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='IntervalList+Effort+ResourceInterval' name='federated.0uojzko1ba6twf13demis06t8iu8' />
          </datasources>
          <datasource-dependencies datasource='federated.0uojzko1ba6twf13demis06t8iu8'>
            <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
            <column caption='MatchingRolesAllocation' datatype='real' name='[Calculation_2125417558289084416]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Role1] = [Role (EffortAllMatrixAG1-1D)] then [Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='Capacity Max HC' datatype='integer' name='[CapacityMaxHC]' role='measure' type='quantitative' />
            <column datatype='real' name='[Capacity]' role='measure' type='quantitative' />
            <column datatype='real' name='[Demand]' role='measure' type='quantitative' />
            <column caption='MatchingRolesDemand' datatype='real' name='[MatchingRolesAllocation (copy 2)_2125417558289817602]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Role (NAMES+INTERVALS)]= [Role (EffortAllMatrixAG1-1D)] then [Demand]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='MatchingRolesCapacity' datatype='real' name='[MatchingRolesDemand (copy)_2125417558290046979]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Role (IntervalsList)]= [Role (EffortAllMatrixAG1-1D)] then [Capacity]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='MatchingRolesMaxHC' datatype='integer' name='[MatchingRolesDemand (copy)_530017390967062528]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='if [Role (IntervalsList)]= [Role (EffortAllMatrixAG1-1D)] then [CapacityMaxHC]&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column caption='Real Duration' datatype='real' name='[RealDuration]' role='measure' type='quantitative' />
            <column datatype='real' name='[ResEffectiveRatio-FTE]' role='measure' type='quantitative' />
            <column datatype='string' name='[Role (EffortAllMatrixAG1-1D)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Role (IntervalsList)]' role='dimension' type='nominal' />
            <column datatype='string' name='[Role1]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;Registered Nurse&quot;' value='RN' />
              </aliases>
            </column>
