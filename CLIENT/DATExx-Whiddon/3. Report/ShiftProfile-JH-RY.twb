      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1sbhw2k04na5tu11gw8ym1rytmdr].[cnt:Allocation:qk]&quot;' value='Rostered shifts' />
          <alias key='&quot;[federated.1sbhw2k04na5tu11gw8ym1rytmdr].[cnt:Calculation_1782360035901440:qk]&quot;' value='Spare' />
          <alias key='&quot;[federated.1sbhw2k04na5tu11gw8ym1rytmdr].[sum:Calculation_1782360035901440:qk]&quot;' value='Spare shifts (capped+Prioritiesed)' />
          <alias key='&quot;[federated.1sbhw2k04na5tu11gw8ym1rytmdr].[sum:Calculation_1782360069238788:qk]&quot;' value='Other shift worker could work' />
