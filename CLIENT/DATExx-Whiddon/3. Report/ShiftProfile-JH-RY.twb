      <column caption='Under-Over Allocation' datatype='string' name='[Calculation_234750168097259522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_234750168095551488]  &lt; 0 THEN &quot;Underallocation&quot;&#13;&#10;ELSEIF [Calculation_234750168095551488]   &gt; 0 THEN  &quot;Overallocation&quot;&#13;&#10;ELSE &quot;OK&quot;&#13;&#10;END' />
