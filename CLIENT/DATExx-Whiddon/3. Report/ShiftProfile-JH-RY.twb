    <worksheet name='Alloc+Spare-LBStatus'>
      <layout-options>
        <title>
          <formatted-text>
            <run bold='true' fontsize='20'>WORKER ALLOCATION + SPARE AVAILABILITIES</run>
          </formatted-text>
        </title>
      </layout-options>
      <table>
        <view>
          <datasources>
            <datasource caption='Roster+LB Status' name='federated.1sbhw2k04na5tu11gw8ym1rytmdr' />
          </datasources>
          <datasource-dependencies datasource='federated.1sbhw2k04na5tu11gw8ym1rytmdr'>
            <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
            <column datatype='real' name='[Balance]' role='measure' type='quantitative' />
            <column datatype='real' name='[C###]' role='measure' type='quantitative' />
            <column caption='Spare' datatype='integer' name='[Calculation_1782360035901440]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF NOT ISNULL([C###]) and ISNULL([Allocation]) &#13;&#10;THEN 1&#13;&#10;ELSE NULL&#13;&#10;END' />
            </column>
            <column caption='Worker' datatype='string' name='[Calculation_1782360046370818]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Facility]+[Role]+STR([Resource])' />
            </column>
            <column caption='LB Status-modified' datatype='string' name='[Calculation_4824434444849152]' role='dimension' type='nominal'>
