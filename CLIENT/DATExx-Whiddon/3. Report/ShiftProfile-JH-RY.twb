        <calculation class='tableau' formula='IF DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-05#) &#13;&#10;THEN &quot;Roster1&quot; &#13;&#10;&#13;&#10;ELSEIF  DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-19#) &#13;&#10;THEN &quot;Roster2&quot;&#13;&#10;&#13;&#10;ELSE &quot;Roster3&quot;&#13;&#10;&#13;&#10;END' />
