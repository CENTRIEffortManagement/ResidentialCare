      <column aggregation='Sum' caption='Allocated Intervals' datatype='integer' name='[AllocatedIntervals]' role='dimension' type='ordinal' />
      <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
      <column caption='Matching D-A Gap' datatype='real' name='[Calculation_1772447938560880640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Role (IntervalsList)]= [Role (EffortAllMatrixAG1-1D)] then [Demand]-[Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='MatchingRolesAllocation' datatype='real' name='[Calculation_2125417558289084416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Role1] = [Role (EffortAllMatrixAG1-1D)] then [Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_2236037252534403072]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [ShiftType (NAMES+INTERVALS)]' />
      </column>
      <column caption='Calculation2' datatype='string' name='[Calculation_2236037252536733698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Attribute (IntervalsList)] = &quot;StartInterval&quot; &#13;&#10;THEN [ShiftType (NAMES+INTERVALS)]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Temp D-A Gap' datatype='real' name='[Calculation_234750168095551488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[RoleShiftAllocation]- [ShiftDemandHCAverage]' />
      </column>
      <column caption='Under-Over Allocation' datatype='string' name='[Calculation_234750168097259522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_234750168095551488]  &lt; 0 THEN &quot;Underallocation&quot;&#13;&#10;ELSEIF [Calculation_234750168095551488]   &gt; 0 THEN  &quot;Overallocation&quot;&#13;&#10;ELSE &quot;OK&quot;&#13;&#10;END' />
      </column>
      <column caption='ROSTER' datatype='string' name='[Calculation_530017390979141633]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-05#) &#13;&#10;THEN &quot;Roster1&quot; &#13;&#10;&#13;&#10;ELSEIF  DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-19#) &#13;&#10;THEN &quot;Roster2&quot;&#13;&#10;&#13;&#10;ELSE &quot;Roster3&quot;&#13;&#10;&#13;&#10;END' />
