            <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
            <column datatype='real' name='[C###]' role='measure' type='quantitative' />
            <column datatype='integer' name='[C##]' role='measure' type='quantitative' />
            <column datatype='integer' name='[C#]' role='measure' type='quantitative' />
            <column caption='*Status' datatype='string' name='[Calculation_1326028674680897540]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF NOT ISNULL([C###]) AND [Allocation] &gt; 0.1 THEN &#13;&#10;    &quot;Available + Allocated&quot;&#13;&#10;&#13;&#10;ELSEIF (NOT ISNULL([C###]) AND ([Allocation] &lt;= 0.1  OR ISNULL([Allocation])) &#13;&#10;    )&#13;&#10;    THEN &#13;&#10;    &quot;Available + UnAllocated&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C###]) AND [Allocation] &gt; 0.3 THEN &#13;&#10;    &quot;AllocatedUnavailable&quot;&#13;&#10;&#13;&#10;ELSEIF NOT ISNULL([C###]) AND [Allocation] &lt;= 0.3 THEN &#13;&#10;    &quot;AllocatedSpill&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C###]) AND NOT ISNULL ([C##]) THEN &#13;&#10;    &quot;RemovedAvailabilityC###&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C##]) AND NOT ISNULL ([C#])THEN &#13;&#10;    &quot;RemovedAvailabilityC##&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &#13;&#10;    &quot;Empty&quot;&#13;&#10;END' />
            </column>
            <column datatype='date' name='[Date]' role='dimension' type='ordinal' />
            <column datatype='integer' name='[Demand]' role='measure' type='quantitative' />
            <column caption='Effort Type' datatype='string' name='[EffortType]' role='dimension' type='nominal'>
              <aliases>
                <alias key='&quot;C\#\#\#&quot;' value='Capacity-Capped' />
                <alias key='&quot;OriginalAvailability&quot;' value='Capacity-Original' />
              </aliases>
            </column>
            <column datatype='string' name='[Facility]' role='dimension' type='nominal' />
            <column datatype='string' name='[Name]' role='dimension' type='nominal' />
            <column caption='Original Availability' datatype='integer' name='[OriginalAvailability]' role='measure' type='quantitative' />
            <column aggregation='Sum' datatype='integer' name='[Resource (AvailabilityDevelopedMAT)]' role='dimension' type='ordinal' />
            <column aggregation='Sum' datatype='integer' name='[Resource]' role='dimension' type='ordinal' />
            <column datatype='string' name='[Role]' role='dimension' type='nominal' />
