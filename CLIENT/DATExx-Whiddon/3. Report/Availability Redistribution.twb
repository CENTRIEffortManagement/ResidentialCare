        <calculation class='tableau' formula='IF NOT ISNULL([C###]) AND [Allocation] &gt; 0.1 THEN &#13;&#10;    &quot;Available + Allocated&quot;&#13;&#10;&#13;&#10;ELSEIF (NOT ISNULL([C###]) AND ([Allocation] &lt;= 0.1  OR ISNULL([Allocation])) &#13;&#10;    )&#13;&#10;    THEN &#13;&#10;    &quot;Available + UnAllocated&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C###]) AND [Allocation] &gt; 0.3 THEN &#13;&#10;    &quot;AllocatedUnavailable&quot;&#13;&#10;&#13;&#10;ELSEIF NOT ISNULL([C###]) AND [Allocation] &lt;= 0.3 THEN &#13;&#10;    &quot;AllocatedSpill&quot;&#13;&#10;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C###]) AND NOT ISNULL ([C##]) THEN &#13;&#10;    &quot;RemovedAvailabilityC###&quot;&#13;&#10;&#13;&#10;ELSEIF ISNULL([C##]) AND NOT ISNULL ([C#])THEN &#13;&#10;    &quot;RemovedAvailabilityC##&quot;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;ELSE &#13;&#10;    &quot;Empty&quot;&#13;&#10;END' />
