          <datasource-dependencies datasource='Parameters'>
            <column alias='ABILITY' caption='#Outcome' datatype='string' name='[#Outcome Parameter]' param-domain-type='list' role='measure' type='nominal' value='&quot;AB&quot;'>
              <calculation class='tableau' formula='&quot;AB&quot;' />
              <aliases>
                <alias key='&quot;AB&quot;' value='ABILITY' />
                <alias key='&quot;EF&quot;' value='EFFICIENCY' />
                <alias key='&quot;WL&quot;' value='INTENSITY' />
              </aliases>
            </column>
          </datasource-dependencies>
          <datasource-dependencies datasource='federated.18j4fgp148exro1gq71ew1r1q51o'>
            <column caption='##Planned Min' datatype='real' name='[##Planned  (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([Ability Pl AG])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([Efficiency Pl AG])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([Workload Pl AG])&#13;&#10;END' />
            </column>
            <column caption='#UnAllocated Slack' datatype='real' name='[#Allocated Slack - AB (copy)_2502875497394470912]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB UNALLOCATED SLACK])&#13;&#10;ELSEIF  [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF UNALLOCATED SLACK])&#13;&#10;ELSEIF  [Calculation_373517350211387393]=&apos;AB&apos; then SUM([WL UNALLOCATED SLACK])&#13;&#10;ELSE 0&#13;&#10;END' />
            </column>
            <column caption='#Potential' datatype='real' name='[#Excess Slack (copy 2)_126945238956761088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB Potential])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF Potential])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL Potential])&#13;&#10;END' />
            </column>
            <column caption='#Spare Slack' datatype='real' name='[#Excess Slack (copy 2)_2502875497394630657]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB SPARE SLACK])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF SPARE SLACK])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL SPARE SLACK])&#13;&#10;END' />
            </column>
            <column caption='#Excess Slack (Allocated)' datatype='real' name='[#Excess Stretch (Allocated) (copy)]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='/* IF [#Outcome]=&apos;AB&apos; then SUM([Ab Excess Allocated Slack])&#13;&#10;ELSEIF [#Outcome]=&apos;EF&apos; then SUM([Ef Excess Allocated Slack])&#13;&#10;ELSEif[#Outcome] = &apos;WL&apos; then sum([WL EXCESS ALLOCATED SLACK])&#13;&#10;END*/' />
            </column>
            <column caption='#Latent Allocated' datatype='real' name='[#Latent (copy)_81064817618112513]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB LATENT.ALLOCATED])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF LATENT.ALLOCATED])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL LATENT.ALLOCATED])&#13;&#10;END' />
            </column>
