      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.0uojzko1ba6twf13demis06t8iu8].[sum:Calculation_1772447938560880640:qk]&quot;' value='GAP' />
          <alias key='&quot;[federated.0uojzko1ba6twf13demis06t8iu8].[sum:Calculation_2125417558289084416:qk]&quot;' value='ALLOCATION' />
          <alias key='&quot;[federated.0uojzko1ba6twf13demis06t8iu8].[sum:MatchingRolesAllocation (copy 2)_2125417558289817602:qk]&quot;' value='DEMAND' />
          <alias key='&quot;[federated.0uojzko1ba6twf13demis06t8iu8].[sum:MatchingRolesDemand (copy)_2125417558290046979:qk]&quot;' value='Capacity' />
        </aliases>
