              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB  LATENT.OVERALLOCATED])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF LATENT.OVERALLOCATED])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL LATENT.OVERALLOCATED])&#13;&#10;END' />
            </column>
