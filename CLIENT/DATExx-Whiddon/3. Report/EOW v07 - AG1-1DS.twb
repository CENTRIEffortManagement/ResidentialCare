          <datasource-dependencies datasource='Parameters'>
            <column caption='Date' datatype='date' name='[Ability Max. (copy)]' param-domain-type='range' role='measure' type='quantitative' value='#2021-07-01#'>
              <calculation class='tableau' formula='#2021-07-01#' />
