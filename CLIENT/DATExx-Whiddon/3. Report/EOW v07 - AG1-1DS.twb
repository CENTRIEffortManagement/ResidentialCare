              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
