      </column>
      <column caption='Ba2' datatype='integer' name='[Calculation_1213157156783386627]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;   &#13;&#10;    &#13;&#10;1&#13;&#10;   &#13;&#10;&#13;&#10;END' />
      </column>
      <column caption='Bb2' datatype='real' name='[Calculation_1213157156783591428]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641264760950784]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1740641264762241030]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_776307996671672329]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996669235202]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669394948]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_776307996669485062]            &#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641264762241030]&#13;&#10;            //L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_776307996671672329]&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_776307996669235202]&#13;&#10;            //L4 InxB: L3-L4 Abx-Inx&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996669394948]&#13;&#10;            //L4 EfnB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669485062]&#13;&#10;            // AbxB:  L5-L6 Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641264760950784]&#13;&#10;        END&#13;&#10;   &#13;&#10;   END&#13;&#10;END' />
      </column>
      <column caption='Intersection' datatype='string' default-role='measure' default-type='quantitative' name='[Calculation_1213157156786044934]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Type]=&quot;Boundary&quot; THEN&#13;&#10;        &#13;&#10;        //  2C+ 6C &lt;1C&#13;&#10;        IF  ABS([Calculation_1740641264762437639])+ABS([Calculation_776307996669820936])&lt; ABS([Calculation_1740641264761020417]) THEN&#13;&#10;            CASE [Calculation_776307996673429514] &#13;&#10;                WHEN &quot;InnBStart&quot; THEN &quot;No&quot;&#13;&#10;                WHEN &quot;InnBFinish&quot; THEN &quot;No&quot;                &#13;&#10;                WHEN &quot;AbnBStart&quot; THEN &quot;Previous&quot;&#13;&#10;                WHEN &quot;EfnBFinish&quot; THEN &quot;Next&quot;&#13;&#10;            END&#13;&#10;        //  3C+ 1C &lt;2C&#13;&#10;        ELSEIF  ABS([Calculation_1740641264761499653])+ABS([Calculation_1740641264761020417])&lt; ABS([Calculation_1740641264762437639]) THEN&#13;&#10;            CASE [Calculation_776307996673429514] &#13;&#10;                WHEN &quot;InnBStart&quot; THEN &quot;No&quot;&#13;&#10;                WHEN &quot;InnBFinish&quot; THEN &quot;No&quot;                &#13;&#10;                WHEN &quot;AbnBStart&quot; THEN &quot;Previous&quot;&#13;&#10;                WHEN &quot;EfnBFinish&quot; THEN &quot;Next&quot;&#13;&#10;            END&#13;&#10;        ELSE &quot;-&quot;&#13;&#10;        END&#13;&#10;END' />
      </column>
      <column caption='OLog EF x' datatype='real' name='[Calculation_122723093165801472]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='SQRT(2)*(LOG([Parameters].[Ability Min. (copy)_759138013782077444]))' />
      </column>
      <column caption='Bc2x' datatype='real' name='[Calculation_1376131167999643658]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            // L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN -(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]))/COS(PI()/3))&#13;&#10;            // L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN (tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3))&#13;&#10;&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN -1.5*SQRT(2/3)*(log([Parameters].[Ability Max. (copy)_759138013781745667]))&#13;&#10;&#13;&#10;//L4 InxB;  L3-L4  Abn-Inx&#13;&#10;when &quot;InxB&quot; THEN 1&#13;&#10;&#13;&#10;            // AbxB: Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN 0&#13;&#10;&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            &#13;&#10;             // L1 InnB: L1-L2 Inn-Efx  2.880823476 @.7&#13;&#10;                WHEN &quot;InnB&quot; THEN &#13;&#10;                    IF  (LOG([Calculation_1740641264762437639])+LOG([Calculation_1740641265056813070]))&lt; LOG([Calculation_1740641264761020417]) THEN NULL&#13;&#10;                    ELSE (tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3))&#13;&#10;                    END&#13;&#10;&#13;&#10;            // L2 EfxB:  L2-L3 Efn-Abn 0.189715381@1.5&#13;&#10;                WHEN &quot;EfxB&quot; THEN  &#13;&#10;&#13;&#10;                    IF  (LOG([Calculation_1740641264761499653])+LOG([Calculation_1740641264761020417]))&lt; LOG([Calculation_1740641264762437639]) THEN NULL&#13;&#10;                    ELSE -1.5*SQRT(2/3)*(log([Parameters].[Ability Max. (copy)_759138013781745667]))&#13;&#10;                    END&#13;&#10;&#13;&#10;            //L3  Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN  -2.01815601&#13;&#10; //tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Ability Min.]))/COS(PI()/3)&#13;&#10;&#13;&#10;            //L4 InxB L3-L40 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot;  THEN -(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]))/COS(PI()/3))&#13;&#10;&#13;&#10;            // AbxB: Efn-Abx&#13;&#10;            //  WHEN &quot;EfxB&quot; THEN 0&#13;&#10;        END&#13;&#10;   &#13;&#10;&#13;&#10; END&#13;&#10;END' />
      </column>
      <column caption='1b' datatype='real' name='[Calculation_1740641264760950784]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='1c' datatype='real' name='[Calculation_1740641264761020417]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    &#13;&#10;       -(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='3c' datatype='real' name='[Calculation_1740641264761499653]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    -(0&#13;&#10;         - &#13;&#10;        (-1.5*SQRT(2/3)*(LOG([Parameters].[Ability Max. (copy)_759138013781745667]))))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
      </column>
      <column caption='2b' datatype='real' name='[Calculation_1740641264762241030]' role='measure' type='quantitative'>
