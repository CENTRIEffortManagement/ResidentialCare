        <calculation class='tableau' formula='if [Type]=&quot;Boundary&quot; THEN&#13;&#10;        &#13;&#10;        //  2C+ 6C &lt;1C&#13;&#10;        IF  ABS([Calculation_1302947675970945032])+ABS([Calculation_1740641265056813070])&lt; ABS([Calculation_1302947675968024583]) THEN&#13;&#10;            CASE [Calculation_1740641265312182297] &#13;&#10;                WHEN &quot;InnBStart&quot; THEN &quot;No&quot;&#13;&#10;                WHEN &quot;InnBFinish&quot; THEN &quot;No&quot;                &#13;&#10;                WHEN &quot;AbnBStart&quot; THEN &quot;Previous&quot;&#13;&#10;                WHEN &quot;EfnBFinish&quot; THEN &quot;Next&quot;&#13;&#10;            END&#13;&#10;        //  3C+ 1C &lt;2C&#13;&#10;        ELSEIF  ABS([Calculation_1302947675971149833])+ABS([Calculation_1302947675968024583])&lt; ABS([Calculation_1302947675970945032]) THEN&#13;&#10;            CASE [Calculation_1740641265312182297] &#13;&#10;                WHEN &quot;InnBStart&quot; THEN &quot;No&quot;&#13;&#10;                WHEN &quot;InnBFinish&quot; THEN &quot;No&quot;                &#13;&#10;                WHEN &quot;AbnBStart&quot; THEN &quot;Previous&quot;&#13;&#10;                WHEN &quot;EfnBFinish&quot; THEN &quot;Next&quot;&#13;&#10;            END&#13;&#10;        ELSE &quot;-&quot;&#13;&#10;        END&#13;&#10;END    &#13;&#10;&#13;&#10;&#13;&#10;//WHEN &quot;InnB&quot; THEN &#13;&#10;            //IF       (ABS([2c])+ABS([6c]))&lt;  ABS([1c]) THEN &quot;No&quot;&#13;&#10;            //ELSEIF  [Position]=&quot;Start&quot; THEN&#13;&#10;                //IF  (ABS([1c])-ABS([5c]))&lt;  ABS([6c]) THEN &quot;Left&quot; END&#13;&#10;            //ELSEIF   [Position]=&quot;Finish&quot; THEN&#13;&#10;                //IF (ABS([3c])+ABS([1c]))&lt;  ABS([2c]) THEN &quot;Right&quot; END&#13;&#10;            //ELSE  &quot;-&quot;&#13;&#10;            //END' />
