              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;(tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3))&#13;&#10;&#13;&#10;   &#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Bc2' datatype='real' name='[Calculation_1740641264767668232]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641264761020417]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1740641264762437639]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1740641264761499653]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996669317123]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669448197]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_776307996669820936]&#13;&#10;&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            &#13;&#10;            //L1 InnB: L6-L1 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641264762437639]&#13;&#10;            //L2 EfxB:  L1-L2 EfX-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1740641264761499653]&#13;&#10;            //L3  Abn: L2-L3 Abx-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_776307996669317123]&#13;&#10;            //L4 InxB: L3-L4 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996669448197]&#13;&#10;            //L4 EfnB: L4-L5 Efn-Abx&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669820936]&#13;&#10;            // AbxB:  L5-L6 Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641264761020417]&#13;&#10;        END &#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='X-L+B' datatype='real' name='[Calculation_552253906380541953]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Type]= &quot;Line&quot; THEN&#13;&#10;    If ([Position]=&quot;Start&quot;) THEN&#13;&#10;            CASE [Threshold] &#13;&#10;&#13;&#10;            WHEN &quot;Abn&quot; THEN 1.5*SQRT(2/3)*(LOG([Parameters].[Ability Max. (copy)_759138013781745667]))  &#13;&#10;            &#13;&#10;            WHEN &quot;Abx&quot; THEN 1.5*SQRT(2/3)*(LOG([Parameters].[Ap Parameter]))&#13;&#10;            &#13;&#10;            WHEN &quot;Efn&quot; THEN   -tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy)_759138013782085637]))/COS(PI()/3)&#13;&#10;            &#13;&#10;            WHEN &quot;Efx&quot; THEN  -tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3)&#13;&#10;&#13;&#10;            &#13;&#10;            WHEN &quot;Inn&quot; THEN tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]))/COS(PI()/3)&#13;&#10;           &#13;&#10;            WHEN &quot;Inx&quot; THEN tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]))/COS(PI()/3)&#13;&#10;&#13;&#10;            END&#13;&#10;&#13;&#10;         ELSEIF ([Position]=&quot;Finish&quot;) THEN&#13;&#10;            CASE [Threshold] &#13;&#10;&#13;&#10;            WHEN &quot;Abn&quot; THEN 1.5*SQRT(2/3)*(LOG([Parameters].[Ability Max. (copy)_759138013781745667]))&#13;&#10;           &#13;&#10;            WHEN &quot;Abx&quot; THEN 1.5*SQRT(2/3)*(LOG([Parameters].[Ap Parameter]))&#13;&#10;&#13;&#10;            WHEN &quot;Efn&quot; THEN tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy)_759138013782085637]))/COS(PI()/3)&#13;&#10;          &#13;&#10;            WHEN &quot;Efx&quot; THEN tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3)&#13;&#10;&#13;&#10;            WHEN &quot;Inn&quot; THEN -tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]))/COS(PI()/3)&#13;&#10;           &#13;&#10;            WHEN &quot;Inx&quot; THEN -tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]))/COS(PI()/3)&#13;&#10;&#13;&#10;            &#13;&#10;            END&#13;&#10;        END&#13;&#10;&#13;&#10; ELSEIF [Type] = &quot;Boundary&quot; then &#13;&#10;   &#13;&#10;       (([Calculation_1213157156782972929]*[Calculation_1740641264767668232]-[Calculation_1213157156783591428]*[Calculation_1213157156783226882])/([Calculation_1213157156782776320]*[Calculation_1213157156783591428]-[Calculation_1213157156782972929]*[Calculation_1213157156783386627]) )&#13;&#10;         &#13;&#10;   &#13;&#10; ELSE [X&apos;]&#13;&#10;END' />
            </column>
            <column caption='4b' datatype='real' name='[Calculation_776307996669235202]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='4c' datatype='real' name='[Calculation_776307996669317123]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;-(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='5b' datatype='real' name='[Calculation_776307996669394948]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    -SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='5c' datatype='real' name='[Calculation_776307996669448197]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  (tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy)_759138013782085637]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
