      <column caption='Under-Over Allocation' datatype='string' name='[Calculation_234750168097259522]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF  [Calculation_234750168095551488]  &lt; 0 THEN &quot;Underallocation&quot;&#13;&#10;ELSEIF [Calculation_234750168095551488]   &gt; 0 THEN  &quot;Overallocation&quot;&#13;&#10;ELSE &quot;OK&quot;&#13;&#10;END' />
      </column>
      <column caption='ROSTER' datatype='string' name='[Calculation_530017390979141633]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-05#) &#13;&#10;THEN &quot;Roster1&quot; &#13;&#10;&#13;&#10;ELSEIF  DATE([ShiftDate (IntervalsList)]) &lt; DATE(#2022-12-19#) &#13;&#10;THEN &quot;Roster2&quot;&#13;&#10;&#13;&#10;ELSE &quot;Roster3&quot;&#13;&#10;&#13;&#10;END' />
