      <column caption='BalanceStatus' datatype='string' name='[Calculation_4196612752678913]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='IF [Calculation_4196612752306176]  &lt; 2 THEN NULL&#13;&#10;ELSEIF [Calculation_4196612752306176] &lt; 5 THEN &quot;L&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176] &lt; 8 THEN &quot;M&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176]&lt; 13 THEN &quot;H&quot;&#13;&#10;ELSEIF [Calculation_4196612752306176] &gt; 20 THEN  &quot;X&quot;&#13;&#10;END' />
