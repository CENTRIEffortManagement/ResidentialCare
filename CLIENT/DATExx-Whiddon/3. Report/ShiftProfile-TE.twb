      <column caption='Matching D-A Gap' datatype='real' name='[Calculation_1772447938560880640]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Role (IntervalsList)]= [Role (EffortAllMatrixAG1-1D)] then [Demand]-[Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='MatchingRolesAllocation' datatype='real' name='[Calculation_2125417558289084416]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='if [Role1] = [Role (EffortAllMatrixAG1-1D)] then [Allocation]&#13;&#10;ELSE 0&#13;&#10;END' />
      </column>
      <column caption='Calculation1' datatype='real' name='[Calculation_2236037252534403072]' role='measure' type='quantitative'>
