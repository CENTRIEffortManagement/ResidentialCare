      <column caption='Calculation2' datatype='string' name='[Calculation_2236037252536733698]' role='dimension' type='nominal'>
        <calculation class='tableau' formula='if [Attribute (IntervalsList)] = &quot;StartInterval&quot; &#13;&#10;THEN [ShiftType (NAMES+INTERVALS)]&#13;&#10;ELSE NULL&#13;&#10;END' />
      </column>
      <column caption='Temp D-A Gap' datatype='real' name='[Calculation_234750168095551488]' role='measure' type='quantitative'>
        <calculation class='tableau' formula='[RoleShiftAllocation]- [ShiftDemandHCAverage]' />
