            </column>
            <column caption='#Potential' datatype='real' name='[#Excess Slack (copy 2)_126945238956761088]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB Potential])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF Potential])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL Potential])&#13;&#10;END' />
