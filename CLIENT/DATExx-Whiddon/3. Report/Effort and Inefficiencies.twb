            </column>
            <column caption='#Spare Stretch Allocated' datatype='real' name='[#Spare Slack Allocated (copy)_2502875497395154947]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB SPARE STRETCH ALLOCATED])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF SPARE STRETCH ALLOCATED])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL SPARE STRETCH ALLOCATED])&#13;&#10;END' />
