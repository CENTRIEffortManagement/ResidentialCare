            <column caption='S:SHORTFALL' datatype='real' name='[Calculation_2240540871977250816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[#Potential Shortfall (copy)_1266918935944032270] + [#Allocated Slack - AB (copy)_2502875497394470912] + &#13;&#10;[Calculation_373517350226415625] + [#Latent (copy)_81064817618112513] + [#Latent Allocated (copy)_81064817618386946] +&#13;&#10;[#Excess Slack (copy 2)_126945238956761088]' />
