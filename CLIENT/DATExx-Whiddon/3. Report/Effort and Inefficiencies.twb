            <column caption='###Bar Size' datatype='real' name='[#Potential Shortfall (copy 2)_1266918936219361298]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Calculation_373517350211387393]=&apos;AB&apos; AND [D]&gt;0 THEN [D] &#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;AB&apos; AND [D]=0 THEN [Cs]&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; AND [Cs]&gt;0 THEN [Cs]&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; AND [Cs]=0 THEN [D]&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos;  AND [A]&gt;0 THEN [A]&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos;  AND [A]=0 THEN [Cs]&#13;&#10;END' />
