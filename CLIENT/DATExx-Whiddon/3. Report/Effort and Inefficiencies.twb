            <column caption='Ab Latent.Allocated' datatype='real' name='[AB LATENT.ALLOCATED]' role='measure' type='quantitative' />
            <column caption='Ab Latent' datatype='real' name='[AB LATENT]' role='measure' type='quantitative' />
            <column caption='Ab Potential Shortfall (Over-Allocated)' datatype='real' name='[AB POTENTIAL SHORTFALL (OVER-ALLOCATED)]' role='measure' type='quantitative' />
