              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB  LATENT.OVERALLOCATED])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF LATENT.OVERALLOCATED])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL LATENT.OVERALLOCATED])&#13;&#10;END' />
            </column>
            <column caption='#Potential Shortfall' datatype='real' name='[#Potential Shortfall (copy)_1266918935944032270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB POTENTIAL SHORTFALL])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF POTENTIAL SHORTFALL])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL POTENTIAL SHORTFALL])&#13;&#10;END' />
            </column>
            <column caption='#Spare Slack Allocated' datatype='real' name='[#Spare Slack (copy)_2502875497394966530]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Calculation_373517350211387393]=&apos;AB&apos; then SUM([AB SPARE SLACK ALLOCATED])&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos; then SUM([EF SPARE SLACK ALLOCATED])&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos; then sum([WL SPARE SLACK ALLOCATED])&#13;&#10;END' />
