              <calculation class='tableau' formula='IF  [Calculation_373517350211387393]=&apos;AB&apos; THEN [D]&#13;&#10;&#13;&#10;ELSEIF [Calculation_373517350211387393]=&apos;EF&apos;  THEN [Cs]&#13;&#10;&#13;&#10;ELSEif[Calculation_373517350211387393] = &apos;WL&apos;  THEN [A]&#13;&#10;&#13;&#10;END' />
