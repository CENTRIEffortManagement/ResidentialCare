            <column caption='S:SHORTFALL' datatype='real' name='[Calculation_2240540871977250816]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[#Potential Shortfall (copy)_1266918935944032270] + [#Allocated Slack - AB (copy)_2502875497394470912] + &#13;&#10;[Calculation_373517350226415625] + [#Latent (copy)_81064817618112513] + [#Latent Allocated (copy)_81064817618386946] +&#13;&#10;[#Excess Slack (copy 2)_126945238956761088]' />
            </column>
            <column caption='S:ABILITY' datatype='real' name='[Calculation_2240540872096399361]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373517350233935887]' />
            </column>
            <column caption='S:UNALLOCATED POTENTIAL' datatype='real' name='[Calculation_2240540872096768002]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373517350227308556] +[Calculation_373517350227058699]' />
            </column>
            <column caption='S:EXCESS ROSTERED' datatype='real' name='[Calculation_2240540872097071107]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373517350215196675] +&#13;&#10;[#Spare Slack Allocated (copy)_2502875497395154947]+&#13;&#10;[#Spare Slack (copy)_2502875497394966530]+&#13;&#10;[Calculation_373517350225260550] +&#13;&#10;[Calculation_647673980655468544]' />
            </column>
            <column caption='S:EXCESS POTENTIAL' datatype='real' name='[Calculation_2240540872097669124]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='[Calculation_373517350224871429] +&#13;&#10;[Calculation_373517350224388100]+&#13;&#10;[#Excess Slack (copy 2)_2502875497394630657] +&#13;&#10;[#Spare Stretch Allocated (copy)_2502875497395417092]' />
            </column>
            <column caption='#Outcome' datatype='string' name='[Calculation_373517350211387393]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='[Parameters].[#Outcome Parameter]' />
            </column>
            <column caption='#Excess Over Allocation' datatype='real' name='[Calculation_373517350215196675]' role='measure' type='quantitative'>
