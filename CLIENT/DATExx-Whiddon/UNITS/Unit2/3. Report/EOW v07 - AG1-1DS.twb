      <aliases enabled='yes' />
      <column datatype='string' name='[:Measure Names]' role='dimension' type='nominal'>
        <aliases>
          <alias key='&quot;[federated.1r3nthy1moqq8o19fca1d1kbe8li].[sum:Apn:qk]&quot;' value='ABILITY' />
          <alias key='&quot;[federated.1r3nthy1moqq8o19fca1d1kbe8li].[sum:Ein:qk]&quot;' value='EFFICIENCY' />
