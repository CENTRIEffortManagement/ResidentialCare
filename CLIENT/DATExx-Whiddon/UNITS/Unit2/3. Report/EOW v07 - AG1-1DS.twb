          <datasource-dependencies datasource='federated.1r3nthy1moqq8o19fca1d1kbe8li'>
            <column caption='X' datatype='real' name='[ABmaxGx (copy)_2104025452607361025]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='If [Type]= &quot;Line&quot; OR [Type]= &quot;Grid&quot; THEN&#13;&#10;    If ([Position]=&quot;Start&quot;) THEN&#13;&#10;            CASE [Threshold] &#13;&#10;&#13;&#10;                WHEN &quot;Abn&quot; THEN 1&#13;&#10;                WHEN &quot;Abx&quot; THEN 1&#13;&#10;&#13;&#10;                WHEN &quot;Efn&quot; THEN 1 &#13;&#10;                WHEN &quot;Efx&quot; THEN 1&#13;&#10;                    &#13;&#10;                WHEN &quot;Inn&quot; THEN 1&#13;&#10;                WHEN &quot;Ino&quot; THEN 1&#13;&#10;           &#13;&#10;                WHEN &quot;Ino&quot; THEN 1&#13;&#10;                WHEN &quot;Inx&quot; THEN 1&#13;&#10;&#13;&#10;            END&#13;&#10;&#13;&#10;         ELSEIF ([Position]=&quot;Finish&quot;) THEN&#13;&#10;            CASE [Threshold] &#13;&#10;&#13;&#10;                WHEN &quot;Abn&quot; THEN 1&#13;&#10;                WHEN &quot;Abx&quot; THEN 1&#13;&#10;                &#13;&#10;                WHEN &quot;Efn&quot; THEN 1&#13;&#10;                WHEN &quot;Efx&quot; THEN 1&#13;&#10;                    &#13;&#10;                WHEN &quot;Inn&quot; THEN 1&#13;&#10;                WHEN &quot;Inx&quot; THEN 1&#13;&#10;&#13;&#10;           END&#13;&#10;        END&#13;&#10;&#13;&#10;&#13;&#10;         &#13;&#10;   &#13;&#10; ELSE [X&apos;]&#13;&#10;END' />
            </column>
            <column datatype='real' name='[Ai]' role='measure' type='quantitative' />
            <column datatype='real' name='[Allocation]' role='measure' type='quantitative' />
            <column datatype='real' name='[Apn]' role='measure' type='quantitative' />
            <column caption='1b' datatype='real' name='[Calculation_1302947675965726723]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='2b' datatype='real' name='[Calculation_1302947675966824452]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;   &#13;&#10; -SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='3b' datatype='integer' name='[Calculation_1302947675967016965]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    0&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='1c' datatype='real' name='[Calculation_1302947675968024583]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    &#13;&#10;       -(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='2c' datatype='real' name='[Calculation_1302947675970945032]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;(tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy)_759138013782077444]))/COS(PI()/3))&#13;&#10;&#13;&#10;   &#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='3c' datatype='real' name='[Calculation_1302947675971149833]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    -(0&#13;&#10;         - &#13;&#10;        (-1.5*SQRT(2/3)*(LOG([Parameters].[Ability Max. (copy)_759138013781745667]))))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Bb1' datatype='real' name='[Calculation_1376131167992066053]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641265288011798]&#13;&#10;            //L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675965726723]&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675966824452]&#13;&#10;            //L4 InxB: L3-L4 Abx-Inx&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1302947675967016965]&#13;&#10;            //L4 EfnB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287626769]&#13;&#10;            // AbxB:  L5-L6 Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265287766035]&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675965726723]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675966824452]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675967016965]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287626769]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287766035]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265288011798]&#13;&#10;        END&#13;&#10;   &#13;&#10;   END&#13;&#10;END' />
            </column>
            <column caption='Bc1' datatype='real' name='[Calculation_1376131167992459270]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641265056813070]&#13;&#10;            //L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675968024583]&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675970945032]&#13;&#10;            //L4 InxB: L3-L4 Abx-Inx&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1302947675971149833]&#13;&#10;            //L4 EfnB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287729170]&#13;&#10;            // AbxB:  L5-L6 Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265287835668]&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675968024583]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675970945032]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675971149833]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287729170]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287835668]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265056813070]&#13;&#10;        END&#13;&#10;   &#13;&#10;   END&#13;&#10;END' />
            </column>
            <column caption='Bb2' datatype='real' name='[Calculation_1376131167999582217]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675965726723]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675966824452]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675967016965]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287626769]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287766035]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265288011798]            &#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            //L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675966824452]&#13;&#10;            //L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675967016965]&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1740641265287626769]&#13;&#10;            //L4 InxB: L3-L4 Abx-Inx&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287766035]&#13;&#10;            //L4 EfnB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265288011798]&#13;&#10;            // AbxB:  L5-L6 Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1302947675965726723]&#13;&#10;        END&#13;&#10;   &#13;&#10;   END&#13;&#10;END' />
            </column>
            <column caption='Bc2' datatype='real' name='[Calculation_1376131167999643658]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675968024583]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675970945032]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1302947675971149833]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287729170]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265287835668]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1740641265056813070]&#13;&#10;&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            &#13;&#10;            //L1 InnB: L6-L1 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1302947675970945032]&#13;&#10;            //L2 EfxB:  L1-L2 EfX-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1302947675971149833]&#13;&#10;            //L3  Abn: L2-L3 Abx-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1740641265287729170]&#13;&#10;            //L4 InxB: L3-L4 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_1740641265287835668]&#13;&#10;            //L4 EfnB: L4-L5 Efn-Abx&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_1740641265056813070]&#13;&#10;            // AbxB:  L5-L6 Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_1302947675968024583]&#13;&#10;        END &#13;&#10;    END&#13;&#10;END' />
            </column>
            <column caption='Line Wieght' datatype='integer' name='[Calculation_1740641264770568201]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='CASE [Type] &#13;&#10;    WHEN &quot;Boundary&quot; then 10&#13;&#10;    WHEN &quot;Line&quot; THEN 3&#13;&#10;&#13;&#10;END' />
            </column>
            <column caption='6c' datatype='real' name='[Calculation_1740641265056813070]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;    -1.5*SQRT(2/3)*(LOG([Parameters].[Ap Parameter]))&#13;&#10;   &#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='4b' datatype='real' name='[Calculation_1740641265287626769]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='4c' datatype='real' name='[Calculation_1740641265287729170]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;-(tan(PI()/3)*SQRT(2) - 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='5b' datatype='real' name='[Calculation_1740641265287766035]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;   - SQRT(2)*TAN(PI()/3) /SQRT(2)&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='5c' datatype='real' name='[Calculation_1740641265287835668]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  (tan(PI()/3)*SQRT(2) + 1.5*SQRT(2/3)*(log([Parameters].[Ability Min. (copy) (copy)_759138013782085637]))/COS(PI()/3))&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='6b' datatype='integer' name='[Calculation_1740641265288011798]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF  [Type]=&quot;Boundary&quot; then&#13;&#10;  0&#13;&#10;ELSE&#13;&#10;    NULL&#13;&#10;END' />
            </column>
            <column caption='Y' datatype='real' name='[Calculation_2104025452606390272]' role='measure' type='quantitative'>
              <calculation class='tableau' formula='IF Type=&quot;Line&quot; THEN&#13;&#10;    IF ([Position]=&quot;Start&quot;) THEN&#13;&#10;        CASE [Threshold] &#13;&#10;&#13;&#10;        WHEN &quot;Abn&quot; THEN 0&#13;&#10;        WHEN &quot;Abo&quot; THEN 0&#13;&#10;        WHEN &quot;Abx&quot; THEN 0&#13;&#10;        WHEN &quot;Efn&quot; THEN 0&#13;&#10;        WHEN &quot;Efo&quot; THEN 0&#13;&#10;        WHEN &quot;Efx&quot; THEN 0&#13;&#10;        WHEN &quot;Inn&quot; THEN 0&#13;&#10;        WHEN &quot;Ino&quot; THEN 0&#13;&#10;        WHEN &quot;Inx&quot; THEN 0&#13;&#10;&#13;&#10;       END&#13;&#10;&#13;&#10;    ELSEIF ([Position]=&quot;Finish&quot;) THEN&#13;&#10;        CASE [Threshold] &#13;&#10;&#13;&#10;        WHEN &quot;Abn&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Abo&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Abx&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Efn&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Efo&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Efx&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Inn&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Ino&quot; THEN 2*SQRT(2)&#13;&#10;        WHEN &quot;Inx&quot; THEN 2*SQRT(2)&#13;&#10;&#13;&#10;           END&#13;&#10;        END&#13;&#10;&#13;&#10; ELSEIF [Type] = &quot;Boundary&quot; then &#13;&#10;   &#13;&#10;       (([Calculation_1376131167992459270]*1-[Calculation_1376131167999643658]*1)/(1*[Calculation_1376131167999582217]-[Calculation_1376131167992066053]*1) )&#13;&#10;&#13;&#10;//  (([Bc1]*[Ba2]-[Bc2]*[Ba1])/([Ba1]*[Bb2]-[Bb1]*[Ba2]) &#13;&#10;&#13;&#10;&#13;&#10;         &#13;&#10;   &#13;&#10; ELSE [Y&apos;]&#13;&#10;END' />
            </column>
            <column caption='In (Not Out)' datatype='string' name='[Calculation_759138013774802945]' role='dimension' type='nominal'>
              <calculation class='tableau' formula='IF [Allocation] = 0 THEN &quot;UNALLOCATED&quot;&#13;&#10;&#13;&#10;ELSEIF ([Apn] &gt;= [Parameters].[Ability Max. (copy)_759138013781745667]) AND ([Apn]&lt;= [Parameters].[Ap Parameter])&#13;&#10;and  ([Ein] &gt;= [Parameters].[Ability Min. (copy) (copy)_759138013782085637]) AND ([Ein]&lt;= [Parameters].[Ability Min. (copy)_759138013782077444]) &#13;&#10;and  ([Iin] &gt;= [Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]) AND ([Iin]&lt;=  [Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]) &#13;&#10;THEN &quot;ACCEPTABLE&quot;&#13;&#10;&#13;&#10;ELSEIF &#13;&#10;[Ai] &gt; 0.95 AND [Ai] &lt; 1.05&#13;&#10;THEN &quot;MARGINAL&quot;&#13;&#10;&#13;&#10;ELSEIF  &#13;&#10;([X&apos;]&gt;-.4 AND   [X&apos;]&lt;0.4) &#13;&#10;&#13;&#10;AND( [Y&apos;] &gt; 1.021  AND [Y&apos;]&lt;1.819)&#13;&#10;THEN &quot;UNACCEPTABLE&quot;&#13;&#10;&#13;&#10;ELSE &quot;EXTREME&quot;&#13;&#10;&#13;&#10;END' />
            </column>
