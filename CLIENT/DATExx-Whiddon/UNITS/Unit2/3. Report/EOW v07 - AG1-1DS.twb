        <calculation class='tableau' formula='IF [Type]=&quot;Boundary&quot; THEN&#13;&#10;    if [Position]=&quot;Start&quot; THEN&#13;&#10;        CASE [Threshold] &#13;&#10;            //L1 InnB: L6-L1 Abx-Inn&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_776307996669485062]&#13;&#10;            //L2 EfxB:  L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1740641264760950784]&#13;&#10;            //L3  Abn: L2-L3 EfX-Abn&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_1740641264762241030]&#13;&#10;            //L4 InxB: L3-L4 Abx-Inx&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996671672329]&#13;&#10;            //L4 EfnB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669235202]&#13;&#10;            // AbxB:  L5-L6 Efn-Abx&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_776307996669394948]&#13;&#10;        END&#13;&#10;&#13;&#10;    ELSEIF [Position]=&quot;Finish&quot; THEN&#13;&#10;             CASE [Threshold] &#13;&#10;            //L1 InnB: L1-L2 Inn-Efx&#13;&#10;                WHEN &quot;InnB&quot; THEN [Calculation_1740641264760950784]&#13;&#10;            //L2 EfxB:  L2-L3 Efx-Abn&#13;&#10;                WHEN &quot;EfxB&quot; THEN [Calculation_1740641264762241030]&#13;&#10;            //L3 Abn: L3-L4 Abn-Inx&#13;&#10;                WHEN &quot;AbnB&quot; THEN [Calculation_776307996671672329]&#13;&#10;            //L4 InxB: L4-L5 Inx-Efn&#13;&#10;                WHEN &quot;InxB&quot; THEN [Calculation_776307996669235202]&#13;&#10;            //L5 InxB: L6-L6 Efn-AbX&#13;&#10;                WHEN &quot;EfnB&quot; THEN [Calculation_776307996669394948]&#13;&#10;            //L6 AbxB: Abx-Inn&#13;&#10;                WHEN &quot;AbxB&quot; THEN [Calculation_776307996669485062]&#13;&#10;        END&#13;&#10;   &#13;&#10;   END&#13;&#10;END' />
      </column>
