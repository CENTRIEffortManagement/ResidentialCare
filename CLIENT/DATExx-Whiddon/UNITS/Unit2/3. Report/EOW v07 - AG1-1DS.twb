      <column caption='GridX' datatype='real' name='[Calculation_2104025452611432451]' role='dimension' type='ordinal'>
        <calculation class='tableau' formula='If ([Position]=&quot;Start&quot;) THEN&#13;&#10;    CASE [Threshold] &#13;&#10;&#13;&#10;    WHEN &quot;Abn&quot; THEN [Parameters].[Ability Max. (copy)_759138013781745667]&#13;&#10;    WHEN &quot;Abo&quot; THEN 0&#13;&#10;    WHEN &quot;Abx&quot; THEN [Parameters].[Ap Parameter]&#13;&#10;    WHEN &quot;Efn&quot; THEN [Parameters].[Ability Min. (copy) (copy)_759138013782085637]&#13;&#10;    WHEN &quot;Efo&quot; THEN 0&#13;&#10;    WHEN &quot;Efx&quot; THEN [Parameters].[Ability Min. (copy)_759138013782077444]&#13;&#10;    WHEN &quot;Inn&quot; THEN [Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]&#13;&#10;    WHEN &quot;Ino&quot; THEN 0&#13;&#10;    WHEN &quot;Inx&quot; THEN [Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]&#13;&#10;&#13;&#10;   END&#13;&#10;&#13;&#10;ELSEIF  ([Position]=&quot;Finish&quot;) THEN&#13;&#10;    CASE [Threshold] &#13;&#10;&#13;&#10;    WHEN &quot;Abn&quot; THEN [Parameters].[Ability Max. (copy)_759138013781745667]&#13;&#10;    WHEN &quot;Abo&quot; THEN 0&#13;&#10;    WHEN &quot;Abx&quot; THEN [Parameters].[Ap Parameter]&#13;&#10;    WHEN &quot;Efn&quot; THEN [Parameters].[Ability Min. (copy) (copy)_759138013782085637]&#13;&#10;    WHEN &quot;Efo&quot; THEN 0&#13;&#10;    WHEN &quot;Efx&quot; THEN [Parameters].[Ability Min. (copy)_759138013782077444]&#13;&#10;    WHEN &quot;Inn&quot; THEN [Parameters].[Ability Min. (copy) (copy) (copy) (copy)_759138013782102023]&#13;&#10;    WHEN &quot;Ino&quot; THEN 0&#13;&#10;    WHEN &quot;Inx&quot; THEN [Parameters].[Ability Min. (copy) (copy) (copy)_759138013782093830]&#13;&#10;&#13;&#10;   END&#13;&#10;&#13;&#10;&#13;&#10;&#13;&#10;END' />
      </column>
