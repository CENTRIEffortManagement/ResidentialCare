# Power Query / Excel transient files
~$*
*.tmp
*.bak
*.backup.*

# Local roster workbooks (any filename casing; Power Query source stays tracked)
*[Rr][Oo][Ss][Tt][Ee][Rr]*.[Xx][Ll][Ss]
*[Rr][Oo][Ss][Tt][Ee][Rr]*.[Xx][Ll][Ss][XxMmBb]

# Logs and local diagnostics
*.log
logs/
**/RunLogs/refresh-worker-*.json
**/RunLogs/BatchRefresh/
**/RunLogs/ArchivedBenchmarks/
**/RunLogs/BatchRefresh.gate
**/RunLogs/BatchCoordinator.gate
**/audit/*
!**/audit/.gitkeep

# Local tool configuration and generated symbols
.vscode/excel-pq-symbols/
.codex/config.toml

# Editor and OS noise
.DS_Store
Thumbs.db
