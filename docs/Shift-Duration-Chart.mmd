    %% standard-FTE conversion, related ratio/check, or material capacity handoff.

    namespace External_sources {
        class roster["Published Roster.xlsx"] {
            +Beaudesert
        }
        class avraw["whiddon_availability_leave_extraction.xlsx"] {
            +Combined Output
        }
    }

